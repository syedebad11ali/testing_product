# secrets — never commit
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.py[cod]

# node
node_modules/

# tooling output
.vercel/
tests/.results/

.local/

# local wheel cache used for offline installs (never commit)
offline_wheels/
.local/
# Protect environment secrets
.env
.env.*
!.env.example

# Also protect nested environment files
**/.env
**/.env.*
!**/.env.example