# Copy to `.env` (repo root) for local development. Never commit `.env`.
# On Vercel set these under Project Settings -> Environment Variables instead.
# Every variable is optional; defaults are shown.

# Enables Gemini answers. Without it the built-in offline engine answers from the records.
GEMINI_API_KEY=
# Comma-separated, tried in order. Set to models your key can access.
GEMINI_MODEL=gemini-3-flash-preview,gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

# HTTP
PORT=5000
RATE_LIMIT_PER_MIN=20
MAX_MESSAGE_LEN=1000
# Origins allowed to call the API from another site (comma-separated, or *). Empty = same-origin only.
ALLOWED_ORIGINS=

VERIFY_RATE_LIMIT_PER_MIN=10
# 1 on Vercel (auto), 0 locally. Only raise if more trusted proxies sit in front of the app.
TRUSTED_PROXY_HOPS=
# Shared rate limiting across serverless instances (https://upstash.com). Leave empty locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enables GET /api/v1/health/detail (send `Authorization: Bearer <token>`). Use a long random value.
HEALTH_DETAIL_TOKEN=

# Advanced overrides (defaults point at backend/datasets and backend/ml/price_model.joblib)
# DATA_DIR=
# MODEL_PATH=
