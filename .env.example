# Copy to `.env` (repo root) for local development. Never commit `.env`.
# On Vercel set these under Project Settings -> Environment Variables instead.
# Every variable is optional; defaults are shown.

# Enables Gemini answers. Without it the built-in offline engine answers from the records.
GEMINI_API_KEY=
# Comma-separated, tried in order. Set to models your key can access.
GEMINI_MODEL=gemini-3-flash-preview,gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

# HTTP
PORT=5000
RATE_LIMIT_PER_MIN=20
MAX_MESSAGE_LEN=1000
# Origins allowed to call the API from another site (comma-separated, or *). Empty = same-origin only.
ALLOWED_ORIGINS=

VERIFY_RATE_LIMIT_PER_MIN=10
# 1 on Vercel (auto), 0 locally. Only raise if more trusted proxies sit in front of the app.
TRUSTED_PROXY_HOPS=
# Shared rate limiting across serverless instances (https://upstash.com). Leave empty locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hand-off buttons in the chat (leave empty to hide). WhatsApp: international format.
CONTACT_WHATSAPP=
CONTACT_EMAIL=
# GET /api/v1/health/detail now needs an admin session (HEALTH_DETAIL_TOKEN was retired).

# --- Accounts, sessions, admin (see docs/AUTH.md) ---------------------------------------------
# development | production (Vercel sets production automatically)
APP_ENV=
# Postgres URL (Neon / Supabase). REQUIRED in production; empty locally = SQLite file at .local/kpt.sqlite3
DATABASE_URL=
# Password for the built-in admin_001 account (hash only is stored). Production refuses weak values:
# 14+ chars, 3+ character types, must not contain the username. Local demo: any throwaway value.
ADMIN_001_PASSWORD=
# DEV ONLY (ignored when APP_ENV=production, and only used with the local SQLite DB). POST /auth/dev-skip (and, in development,
# the Developer Login page) send everyone to /nice-try, EXCEPT username admin__01 + this password, which opens /admin.
# Leave empty = nobody gets in. Never set this on Vercel / production.
DEV_ADMIN_PASSWORD=
# Secret used to hash IPs stored in login events. Set a long random value in production.
IP_HASH_SALT=
# Google sign-in (see docs/AUTH.md for the Google Cloud steps). Public value, not a secret. Empty = disabled.
GOOGLE_CLIENT_ID=
# Comma-separated emails that become admin when they sign in with Google (verified email only).
ADMIN_EMAILS=
# Password-reset emails (Resend, https://resend.com). All three empty = reset by email disabled (the page says so).
RESEND_API_KEY=
MAIL_FROM=
# Public https URL used in emailed links (Vercel: falls back to VERCEL_URL). Local: http://localhost:5000
APP_BASE_URL=
SESSION_IDLE_S=1800
SESSION_ABSOLUTE_S=43200
LOGIN_RATE_LIMIT_PER_MIN=10
LOCKOUT_THRESHOLD=5
# Force Secure/__Host- cookies on or off (default: on in production, off for plain-http local dev)
COOKIE_SECURE=

# Advanced overrides (defaults point at backend/datasets and backend/ml/price_model.joblib)
# DATA_DIR=
# MODEL_PATH=

# --- Cookies (Part 2B) ---
# Days a "Remember me" token lives (admins never get one). Default 30.
REMEMBER_DAYS=30
# Days the anonymous chat-continuity cookie (and its stored conversation) lives. Default 7.
CHAT_COOKIE_DAYS=7

# --- Messaging (see docs/MESSAGING.md) ---
# Message retention is OFF until an owner-approved period is set (docs/MESSAGING.md > Retention).
MESSAGE_RETENTION_DAYS=0
REPORT_RETENTION_DAYS=730
MESSAGE_RATE_LIMIT_PER_MIN=20

# Admin two-factor (docs/ADMIN.md). Generate the key with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
# Set to 1 only AFTER every admin is enrolled and recovery (scripts/reset_admin_totp.py) has been rehearsed.
ADMIN_TOTP_REQUIRED=0
TOTP_ISSUER=Karachi Property Trust
STEPUP_TTL_S=120

# --- Optional: OpenAI Agents SDK engine (default AI_ENGINE=gemini changes nothing) ---
# AI_ENGINE=agents turns it on. AGENTS_PROVIDER=openai uses OPENAI_API_KEY; =gemini reuses GEMINI_API_KEY
# through Gemini's OpenAI-compatible endpoint. If the SDK or key is missing, the chat falls back automatically.
AI_ENGINE=gemini
AGENTS_PROVIDER=openai
OPENAI_API_KEY=
# Comma-separated = fallback order, e.g. gpt-4o-mini,gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini
AGENTS_TIMEOUT_S=20
AGENTS_MAX_TURNS=6
# AGENTS_MODE=handoffs uses a front-desk agent that hands off to Price Estimator / Market Analyst / Property Finder; =single uses one agent with every tool.
AGENTS_MODE=handoffs
# Engines tried in this order (each skipped when not enabled), then the offline engine. Live-search questions always use Gemini.
AI_ORDER=agents,gemini

# --- Guest sessions ("Continue as Guest"; restricted, no account) -----------------------------------------------
# Idle and absolute lifetime of a guest session in seconds, and the most live guest sessions per (hashed) IP address.
GUEST_SESSION_IDLE_S=900
GUEST_SESSION_ABSOLUTE_S=7200
GUEST_MAX_ACTIVE_PER_IP=10
